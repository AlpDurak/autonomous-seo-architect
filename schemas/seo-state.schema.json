{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous SEO Architect State",
  "type": "object",
  "required": [
    "schema_version",
    "current_phase",
    "approvals",
    "dev_server",
      "targets",
      "artifacts",
      "data_sources",
      "analysis_modules",
      "file_hashes_before_edit",
      "changes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "current_phase": {
      "type": "string",
      "enum": [
        "phase_1_project_analysis",
        "phase_2_deep_seo_audit",
        "phase_3_safe_code_execution",
        "phase_4_validation_reporting"
      ]
    },
    "approvals": {
      "type": "object",
      "required": ["phase_1_manifesto", "phase_2_checklist"],
      "properties": {
        "phase_1_manifesto": {
          "type": "boolean"
        },
        "phase_2_checklist": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "dev_server": {
      "type": "object",
      "properties": {
        "url": {
          "type": ["string", "null"]
        },
        "start_command": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "targets": {
      "type": "array"
    },
    "artifacts": {
      "type": "object",
      "required": [
        "manifesto",
        "checklist",
        "opportunities_json",
        "competitor_keyword_analysis",
        "performance_audit",
        "report",
        "internal_link_graph",
        "search_console_import",
        "rendered_seo",
        "static_crawl",
        "pagespeed_crux",
        "structured_data_validation",
        "server_log_analysis",
        "opportunity_scores",
        "monitoring_snapshot",
        "evidence_dir"
      ],
      "properties": {
        "manifesto": {
          "const": "project_manifesto.md"
        },
        "checklist": {
          "const": "seo_dynamic_checklist.md"
        },
        "opportunities_json": {
          "const": "seo_opportunities.json"
        },
        "competitor_keyword_analysis": {
          "const": "seo_competitor_keyword_analysis.md"
        },
        "performance_audit": {
          "const": "seo_performance_audit.md"
        },
        "report": {
          "const": "seo_changelog_report.md"
        },
        "internal_link_graph": {
          "const": ".seo-agent/internal_link_graph.json"
        },
        "search_console_import": {
          "const": ".seo-agent/search_console_import.json"
        },
        "rendered_seo": {
          "const": ".seo-agent/evidence/rendered_seo.json"
        },
        "static_crawl": {
          "const": ".seo-agent/evidence/static_crawl.json"
        },
        "pagespeed_crux": {
          "const": ".seo-agent/evidence/pagespeed_crux.json"
        },
        "structured_data_validation": {
          "const": ".seo-agent/evidence/structured_data_validation.json"
        },
        "server_log_analysis": {
          "const": ".seo-agent/evidence/server_log_analysis.json"
        },
        "opportunity_scores": {
          "const": ".seo-agent/opportunity_scores.json"
        },
        "monitoring_snapshot": {
          "const": ".seo-agent/monitoring_snapshot.json"
        },
        "evidence_dir": {
          "const": ".seo-agent/evidence"
        }
      },
      "additionalProperties": true
    },
    "data_sources": {
      "type": "object",
      "properties": {
        "competitor_keyword_exports": {
          "type": "array"
        },
        "serp_exports": {
          "type": "array"
        },
        "gsc_exports": {
          "type": "array"
        },
        "competitor_urls": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "analysis_modules": {
      "type": "object",
      "properties": {
        "competitor_keyword_gap": {
          "type": "boolean"
        },
        "serp_competitor_discovery": {
          "type": "boolean"
        },
        "competitor_content_entity_gap": {
          "type": "boolean"
        },
        "load_speed_audit": {
          "type": "boolean"
        },
        "gsc_opportunity_mining": {
          "type": "boolean"
        },
        "ai_visibility_audit": {
          "type": "boolean"
        },
        "internal_link_graph_scoring": {
          "type": "boolean"
        },
        "machine_readable_reporting": {
          "type": "boolean"
        },
        "falsifiable_recommendations": {
          "type": "boolean"
        },
        "structured_data_validation": {
          "type": "boolean"
        },
        "server_log_analysis": {
          "type": "boolean"
        },
        "opportunity_scoring": {
          "type": "boolean"
        },
        "monitoring_mode": {
          "type": "boolean"
        },
        "industry_playbooks": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "file_hashes_before_edit": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "changes": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
