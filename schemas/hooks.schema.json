{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous SEO Architect Hook Manifest",
  "type": "object",
  "required": ["hooks"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "command"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "matcher": {
              "type": "string"
            },
            "blocking": {
              "type": "boolean"
            },
            "command": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
