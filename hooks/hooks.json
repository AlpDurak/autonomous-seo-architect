{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/seo_state_guard.py\" pre-edit --workspace \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/seo_state_guard.py\" pre-shell --workspace \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/seo_state_guard.py\" pre-complete --workspace \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ]
  }
}
